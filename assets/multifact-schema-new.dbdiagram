//fact hibah = 1 row 1 hibah
Table fact_hibah {
  hibah_fact_id INT [pk]
  ketua_id INT
  hibah_proposal_id VARCHAR
  // hibah_progress_id INT
  skema_id INT
  sdgs_id INT
  // file_id text // s3://file.pdf
  // hibah_final_id INT
  total_anggota_mahasiswa int
  total_anggota_dosen int
  // usulan_biaya BIGINT
}

// Table dim_file {
//   file_id int [pk] // s3://file.pdf
//   upload_time timestamp
//   size int
//   filename varchar
//   file_link varchar
// }

Table fact_dosen_hibah {
  dosen_hibah_id INT [pk]
  dosen_id INT
  hibah_proposal_id VARCHAR
  tahun INT
  role VARCHAR
  jenis_hibah VARCHAR //penelitian,pengabdian,buku_keilmuan
  status_hibah varchar //diterima, ditolak, diusulkan
  // indikator_count INT
}

Table fact_sitasi {
  sitasi_id INT [pk]
  dosen_id INT
  jurnal_id INT
  total_publikasi INT
  total_internasional INT
  total_nasional INT
  // tahun INT
  // bulan int
  // hari int
  // sitasi BIGINT
  // doi varchar
}

Ref: fact_hibah.ketua_id > dim_dosen.dosen_id
Ref: fact_hibah.hibah_proposal_id > dim_hibah_proposal.hibah_proposal_id
Ref: fact_hibah.skema_id > dim_skema.skema_id
Ref: fact_hibah.sdgs_id > dim_sdgs.sdgs_id
Ref: fact_dosen_hibah.dosen_id > dim_dosen.dosen_id
Ref: fact_dosen_hibah.hibah_proposal_id > dim_hibah_proposal.hibah_proposal_id
Ref: fact_sitasi.dosen_id > dim_dosen.dosen_id
Ref: fact_sitasi.jurnal_id > dim_jurnal.jurnal_id
// Ref: fact_hibah.hibah_progress_id > dim_hibah_progress.hibah_progress_id
