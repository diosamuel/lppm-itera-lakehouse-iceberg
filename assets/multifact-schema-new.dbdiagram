Table dim_dosen {
  dosen_id INT [pk]
  nip VARCHAR
  nama VARCHAR
  //prodi VARCHAR
  //fakultas VARCHAR
}

Table dim_skema {
  skema_id INT [pk]
  nama_skema VARCHAR
  pendanaan_maks INT
}

Table dim_sdgs {
  sdgs_id INT [pk]
  kode_sdgs VARCHAR
}

Table dim_jurnal {
  jurnal_id INT [pk]
  nama_jurnal VARCHAR
  rank_jurnal varchar
  kategori_jurnal VARCHAR
}

Table dim_hibah_proposal {
  hibah_proposal_id VARCHAR [pk]
  judul_proposal VARCHAR
  status_proposal VARCHAR
  lap_judul_penelitian varchar
  lap_identitas_pengusul text
  // jumlah_dana_usulan bigint
  lap_rekam_jejak_ketua_pengusul text
  lap_bidang_kepakaran text
  lap_bidang_penugasan text
  lap_bidang_prioritas text
  lap_sdgs text
  lap_ringkasan text
  lap_kata_kunci text
  lap_pendahuluan text
  lap_metode text
  lap_hasil_yang_diharapkan text
  lap_jadwal_penelitian text
  lap_biaya_penelitian text
  lap_daftar_pustaka text
  lap_scope_penelitian text
}

